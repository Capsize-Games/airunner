diff --git a/tests/test_context_params_abi.py b/tests/test_context_params_abi.py
new file mode 100644
index 0000000..82a1008
--- /dev/null
+++ b/tests/test_context_params_abi.py
@@ -0,0 +1,179 @@
+"""Keep the ctypes context-parameter layout aligned with llama.cpp 7acb4e8."""
+
+from __future__ import annotations
+
+import ast
+import ctypes
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def load_context_params_from_source():
+    """Evaluate only the data-only ctypes structure, without loading libllama."""
+    tree = ast.parse((ROOT / "llama_cpp/llama_cpp.py").read_text())
+    structure = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == "llama_context_params"
+    )
+
+    class SamplerConfig(ctypes.Structure):
+        _fields_ = [("seq_id", ctypes.c_int32), ("sampler", ctypes.c_void_p)]
+
+    namespace = {
+        "ctypes": ctypes,
+        "TYPE_CHECKING": False,
+        "llama_seq_id": ctypes.c_int32,
+        "llama_sampler_seq_config": SamplerConfig,
+        "ggml_backend_sched_eval_callback": ctypes.CFUNCTYPE(
+            ctypes.c_bool,
+            ctypes.c_void_p,
+            ctypes.c_bool,
+            ctypes.c_void_p,
+        ),
+        "ggml_abort_callback": ctypes.CFUNCTYPE(ctypes.c_bool, ctypes.c_void_p),
+    }
+    module = ast.Module(body=[structure], type_ignores=[])
+    exec(compile(module, str(ROOT / "llama_cpp/llama_cpp.py"), "exec"), namespace)
+    return namespace["llama_context_params"]
+
+
+class ContextParamsAbiTests(unittest.TestCase):
+    def test_context_type_values_match_llama_cpp_7acb4e8(self):
+        tree = ast.parse((ROOT / "llama_cpp/llama_cpp.py").read_text())
+        values = {
+            target.id: node.value.value
+            for node in tree.body
+            if isinstance(node, ast.Assign)
+            and isinstance(node.value, ast.Constant)
+            for target in node.targets
+            if isinstance(target, ast.Name)
+            and target.id in {"LLAMA_CONTEXT_TYPE_DEFAULT", "LLAMA_CONTEXT_TYPE_MTP"}
+        }
+        self.assertEqual(
+            values,
+            {"LLAMA_CONTEXT_TYPE_DEFAULT": 0, "LLAMA_CONTEXT_TYPE_MTP": 1},
+        )
+
+    def test_context_params_matches_llama_cpp_7acb4e8_layout(self):
+        params = load_context_params_from_source()
+        expected_offsets = {
+            "n_ctx": 0,
+            "n_batch": 4,
+            "n_ubatch": 8,
+            "n_seq_max": 12,
+            "n_rs_seq": 16,
+            "n_outputs_max": 20,
+            "n_threads": 24,
+            "n_threads_batch": 28,
+            "ctx_type": 32,
+            "rope_scaling_type": 36,
+            "pooling_type": 40,
+            "attention_type": 44,
+            "flash_attn_type": 48,
+            "rope_freq_base": 52,
+            "rope_freq_scale": 56,
+            "yarn_ext_factor": 60,
+            "yarn_attn_factor": 64,
+            "yarn_beta_fast": 68,
+            "yarn_beta_slow": 72,
+            "yarn_orig_ctx": 76,
+            "defrag_thold": 80,
+            "cb_eval": 88,
+            "cb_eval_user_data": 96,
+            "type_k": 104,
+            "type_v": 108,
+            "abort_callback": 112,
+            "abort_callback_data": 120,
+            "embeddings": 128,
+            "offload_kqv": 129,
+            "no_perf": 130,
+            "op_offload": 131,
+            "swa_full": 132,
+            "kv_unified": 133,
+            "samplers": 136,
+            "n_samplers": 144,
+        }
+        self.assertEqual(ctypes.sizeof(params), 152)
+        self.assertEqual({name: getattr(params, name).offset for name, _ in params._fields_}, expected_offsets)
+
+    def test_ctypes_layout_matches_compiled_pinned_llama_header(self):
+        include = Path(
+            os.environ.get(
+                "LLAMA_CPP_INCLUDE_DIR", ROOT / "vendor/llama.cpp/include"
+            )
+        )
+        ggml_include = include.parent / "ggml/include"
+        compiler = shutil.which("c++")
+        self.assertIsNotNone(compiler, "C++ compiler is required for ABI verification")
+        self.assertTrue((include / "llama.h").is_file(), include)
+        self.assertTrue((ggml_include / "ggml.h").is_file(), ggml_include)
+
+        fields = [name for name, _ in load_context_params_from_source()._fields_]
+        lines = [
+            "#include <cstddef>",
+            "#include <cstdio>",
+            "#include <type_traits>",
+            '#include "llama.h"',
+            "using context_default_fn = llama_context_params (*)();",
+            "using init_from_model_fn = llama_context * (*)(llama_model *, llama_context_params);",
+            "using new_context_fn = llama_context * (*)(llama_model *, llama_context_params);",
+            "static_assert(std::is_same_v<decltype(&llama_context_default_params), context_default_fn>);",
+            "static_assert(std::is_same_v<decltype(&llama_init_from_model), init_from_model_fn>);",
+            "static_assert(std::is_same_v<decltype(&llama_new_context_with_model), new_context_fn>);",
+            "int main() {",
+            '  std::printf("sizeof=%zu\\n", sizeof(llama_context_params));',
+        ]
+        lines.extend(
+            f'  std::printf("{name}=%zu\\n", offsetof(llama_context_params, {name}));'
+            for name in fields
+        )
+        lines.append("}")
+        with tempfile.TemporaryDirectory(prefix="llama-abi-") as temp:
+            temp_path = Path(temp)
+            source = temp_path / "probe.cpp"
+            binary = temp_path / "probe"
+            source.write_text("\n".join(lines) + "\n")
+            subprocess.run(
+                [
+                    compiler,
+                    "-std=c++17",
+                    "-I",
+                    str(include),
+                    "-I",
+                    str(ggml_include),
+                    str(source),
+                    "-o",
+                    str(binary),
+                ],
+                check=True,
+                capture_output=True,
+                text=True,
+                timeout=30,
+            )
+            output = subprocess.run(
+                [str(binary)], check=True, capture_output=True, text=True, timeout=5
+            ).stdout
+
+        compiled = {
+            key: int(value)
+            for line in output.splitlines()
+            for key, value in [line.split("=", 1)]
+        }
+        params = load_context_params_from_source()
+        ctypes_layout = {"sizeof": ctypes.sizeof(params)}
+        ctypes_layout.update(
+            {name: getattr(params, name).offset for name, _ in params._fields_}
+        )
+        self.assertEqual(compiled, ctypes_layout)
+
+
+if __name__ == "__main__":
+    unittest.main()
