new file mode 100644
index 0000000..a4e7191
--- /dev/null
+++ b/tests/test_diskcache_optional_dependency.py
@@ -0,0 +1,111 @@
+"""Static contract checks for the optional disk-cache dependency."""
+
+from __future__ import annotations
+
+import ast
+from pathlib import Path
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class DiskCacheOptionalDependencyTests(unittest.TestCase):
+    def test_diskcache_is_imported_only_when_disk_cache_is_constructed(self):
+        tree = ast.parse((ROOT / "llama_cpp/llama_cache.py").read_text())
+        top_level_imports = [
+            node
+            for node in tree.body
+            if isinstance(node, (ast.Import, ast.ImportFrom))
+        ]
+        self.assertFalse(
+            any(
+                isinstance(node, ast.Import)
+                and any(alias.name == "diskcache" for alias in node.names)
+                or isinstance(node, ast.ImportFrom)
+                and node.module == "diskcache"
+                for node in top_level_imports
+            )
+        )
+
+        disk_cache = next(
+            node
+            for node in tree.body
+            if isinstance(node, ast.ClassDef) and node.name == "LlamaDiskCache"
+        )
+        initializer = next(
+            node
+            for node in disk_cache.body
+            if isinstance(node, ast.FunctionDef) and node.name == "__init__"
+        )
+        self.assertTrue(
+            any(
+                isinstance(node, ast.Import)
+                and any(alias.name == "diskcache" for alias in node.names)
+                for node in ast.walk(initializer)
+            )
+        )
+        self.assertTrue(
+            any(
+                isinstance(node, ast.Raise)
+                and isinstance(node.exc, ast.Call)
+                and isinstance(node.exc.func, ast.Name)
+                and node.exc.func.id == "ImportError"
+                for node in ast.walk(initializer)
+            )
+        )
+
+    def test_ram_cache_public_names_remain_available_without_diskcache(self):
+        tree = ast.parse((ROOT / "llama_cpp/llama.py").read_text())
+        imports = [
+            alias.name
+            for node in tree.body
+            if isinstance(node, ast.ImportFrom)
+            and node.module == "llama_cache"
+            and node.level == 1
+            for alias in node.names
+        ]
+        self.assertEqual(
+            imports,
+            ["BaseLlamaCache", "LlamaCache", "LlamaDiskCache", "LlamaRAMCache"],
+        )
+        cache_tree = ast.parse((ROOT / "llama_cpp/llama_cache.py").read_text())
+        class_names = {
+            node.name for node in cache_tree.body if isinstance(node, ast.ClassDef)
+        }
+        self.assertTrue({"LlamaRAMCache", "LlamaDiskCache"} <= class_names)
+        self.assertTrue(
+            any(
+                isinstance(node, ast.Assign)
+                and any(
+                    isinstance(target, ast.Name) and target.id == "LlamaCache"
+                    for target in node.targets
+                )
+                and isinstance(node.value, ast.Name)
+                and node.value.id == "LlamaRAMCache"
+                for node in cache_tree.body
+            )
+        )
+
+    def test_diskcache_is_an_explicit_optional_extra(self):
+        pyproject = (ROOT / "pyproject.toml").read_text()
+        dependencies = pyproject.split("dependencies = [", 1)[1].split("]", 1)[0]
+        self.assertFalse(
+            any(line.strip().startswith('"diskcache') for line in dependencies.splitlines())
+        )
+        self.assertIn('disk = ["diskcache>=5.6.1"]', pyproject)
+        package_tree = ast.parse((ROOT / "llama_cpp/__init__.py").read_text())
+        version = next(
+            node.value.value
+            for node in package_tree.body
+            if isinstance(node, ast.Assign)
+            and any(
+                isinstance(target, ast.Name) and target.id == "__version__"
+                for target in node.targets
+            )
+        )
+        self.assertEqual(version, "0.3.21+capsize.3")
+
+
+if __name__ == "__main__":
+    unittest.main()
