# The per-package README is used as long_description (issue #2061); it must
# survive the sdist -> wheel phase of `python -m build`.
include README.md

# Application policy resources are optional and excluded from standard
# distributions. Use the standalone policy staging tools and an explicit
# application packaging configuration when an application chooses them.
exclude src/airunner_services/content_safety/data/*.dat
exclude src/airunner_services/content_safety/data/*.dat.sig
exclude src/airunner_services/content_safety/data/policy_trust_store.json
