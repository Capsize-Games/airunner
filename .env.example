# Docker Compose environment template for AI Runner.
#
# Copy this file to `.env` (docker compose reads `.env` automatically) and
# adjust the values for your host, then run:
#
#     cp .env.example .env
#
# The compose file cannot run `id -u` itself, so it interpolates these
# variables and only falls back to UID/GID 1000 when they are unset. If your
# UID is not 1000, set the values below or your containers will run with the
# wrong user and the X11/PulseAudio mounts will point at non-existent paths.

# Your host user id:  `id -u`
UID=1000

# Your host group id: `id -g`
GID=1000

# Your user runtime directory. Usually already exported by the desktop
# session; set it explicitly if it is not: `echo $XDG_RUNTIME_DIR`
# (typically /run/user/<UID>).
XDG_RUNTIME_DIR=/run/user/1000

# X11 authorization cookie path. Usually already exported by the display
# manager; set it explicitly if it is not: `echo $XAUTHORITY`
XAUTHORITY=/home/your-user/.Xauthority
