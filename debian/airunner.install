debian/daemon.yaml usr/share/doc/airunner/examples
# Canonical seed for /etc/airunner/daemon.yaml (postinst copies from
# here, not from the doc dir: systems with path-exclude doc stripping
# such as containers never install usr/share/doc; issue #2250).
debian/daemon.yaml usr/share/airunner
# Pure-python airunner_native launcher module (native/ sister dist). The
# daemon imports it at startup; pybuild cannot build two source trees
# into one binary package, so the module ships as files (no dist-info,
# no airunner-native console script — nothing queries its metadata and
# the CLI dispatches desktop flows out of scope for services-only).
native/src/airunner_native usr/lib/python3/dist-packages
# Verbatim airunner-common 6.1.7 package (debian/vendor/README.source,
# issue #2243 Gap 1). Hard services import that dh_python3 cannot map
# to a distro package; ships as files like airunner_native above until
# airunner-common publishes its own Debian binary (then this stanza
# becomes a Depends instead). No dist-info: nothing queries it.
debian/vendor/airunner_common usr/lib/python3/dist-packages
